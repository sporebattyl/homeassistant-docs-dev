{
  "dashboard": {
    "id": null,
    "title": "HASSBOT Home Overview",
    "tags": ["home", "overview", "climate"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Current House Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "house_temperature",
            "legendFormat": "House Temp",
            "refId": "A"
          },
          {
            "expr": "house_humidity", 
            "legendFormat": "House Humidity",
            "refId": "B"
          },
          {
            "expr": "thermostat_current_temperature",
            "legendFormat": "Thermostat Temp",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "list",
              "orientation": "horizontal"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null},
                {"color": "green", "value": 70},
                {"color": "yellow", "value": 76},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "fahrenheit"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 2,
        "title": "Room Temperature Overview",
        "type": "bargauge",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "aqaratemphumid1_temperature",
            "legendFormat": "Living Room",
            "refId": "A"
          },
          {
            "expr": "aqaratemphumid2_temperature",
            "legendFormat": "Kitchen", 
            "refId": "B"
          },
          {
            "expr": "aqaratemphumid3_temperature",
            "legendFormat": "Guest Bedroom",
            "refId": "C"
          },
          {
            "expr": "aqaratemphumid4_temperature",
            "legendFormat": "Rowan's Room",
            "refId": "D"
          },
          {
            "expr": "aqaratemphumid7_temperature",
            "legendFormat": "Master Bedroom",
            "refId": "E"
          },
          {
            "expr": "aqaratemphumid9_temperature",
            "legendFormat": "Office",
            "refId": "F"
          },
          {
            "expr": "aqaratemphumid5_temperature",
            "legendFormat": "Guest Bathroom",
            "refId": "G"
          },
          {
            "expr": "aqaratemphumid6_temperature",
            "legendFormat": "Master Bathroom",
            "refId": "H"
          },
          {
            "expr": "aqaratemphumid8_temperature",
            "legendFormat": "Laundry",
            "refId": "I"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "displayMode": "gradient",
              "orientation": "horizontal"
            },
            "mappings": [],
            "max": 82,
            "min": 68,
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null},
                {"color": "green", "value": 70},
                {"color": "yellow", "value": 76},
                {"color": "orange", "value": 78},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "fahrenheit"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 3,
        "title": "Room Humidity Overview", 
        "type": "bargauge",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "aqaratemphumid1_humidity",
            "legendFormat": "Living Room",
            "refId": "A"
          },
          {
            "expr": "aqaratemphumid2_humidity",
            "legendFormat": "Kitchen",
            "refId": "B"
          },
          {
            "expr": "aqaratemphumid3_humidity",
            "legendFormat": "Guest Bedroom",
            "refId": "C"
          },
          {
            "expr": "aqaratemphumid4_humidity",
            "legendFormat": "Rowan's Room",
            "refId": "D"
          },
          {
            "expr": "aqaratemphumid7_humidity",
            "legendFormat": "Master Bedroom",
            "refId": "E"
          },
          {
            "expr": "aqaratemphumid9_humidity",
            "legendFormat": "Office",
            "refId": "F"
          },
          {
            "expr": "aqaratemphumid5_humidity",
            "legendFormat": "Guest Bathroom",
            "refId": "G"
          },
          {
            "expr": "aqaratemphumid6_humidity",
            "legendFormat": "Master Bathroom",
            "refId": "H"
          },
          {
            "expr": "aqaratemphumid8_humidity",
            "legendFormat": "Laundry",
            "refId": "I"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "displayMode": "gradient",
              "orientation": "horizontal"
            },
            "mappings": [],
            "max": 60,
            "min": 30,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 35},
                {"color": "green", "value": 40},
                {"color": "green", "value": 50},
                {"color": "yellow", "value": 55},
                {"color": "red", "value": 60}
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "displayMode": "gradient"
