      },
      {
        "id": 4,
        "title": "HVAC System Status",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 17},
        "targets": [
          {
            "expr": "climate_thermostat_hvac_action",
            "legendFormat": "HVAC Action",
            "refId": "A"
          },
          {
            "expr": "hvac_target_temperature",
            "legendFormat": "Target Temp",
            "refId": "B"
          },
          {
            "expr": "thermostat_current_temperature",
            "legendFormat": "Current Temp",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "list",
              "orientation": "vertical"
            },
            "mappings": [
              {"options": {"cooling": {"color": "blue", "index": 0}}, "type": "value"},
              {"options": {"heating": {"color": "red", "index": 1}}, "type": "value"},
              {"options": {"idle": {"color": "green", "index": 2}}, "type": "value"},
              {"options": {"off": {"color": "gray", "index": 3}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "vertical",
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 5,
        "title": "Energy Consumption Summary",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 17},
        "targets": [
          {
            "expr": "climate_system_energy_usage",
            "legendFormat": "Total Climate Energy",
            "refId": "A"
          },
          {
            "expr": "hvac_energy_daily",
            "legendFormat": "HVAC Daily",
            "refId": "B"
          },
          {
            "expr": "dehumidifier_energy_daily",
            "legendFormat": "Dehumidifier Daily",
            "refId": "C"
          },
          {
            "expr": "fans_energy_daily", 
            "legendFormat": "Fans Daily",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 2},
                {"color": "orange", "value": 5},
                {"color": "red", "value": 10}
              ]
            },
            "unit": "kwatth"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "vertical",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 6,
        "title": "System Health Indicators",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 17},
        "targets": [
          {
            "expr": "climate_system_performance_score",
            "legendFormat": "Performance Score",
            "refId": "A"
          },
          {
            "expr": "climate_system_maintenance_score",
            "legendFormat": "Maintenance Score",
            "refId": "B"
          },
          {
            "expr": "hvac_system_health",
            "legendFormat": "HVAC Health",
            "refId": "C"
          },
          {
            "expr": "fan_system_health",
            "legendFormat": "Fan Health",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [
              {"options": {"Maintenance Due Soon": {"color": "yellow", "index": 0}}, "type": "value"},
              {"options": {"High Usage": {"color": "orange", "index": 1}}, "type": "value"},
              {"options": {"Normal": {"color": "green", "index": 2}}, "type": "value"},
              {"options": {"Active": {"color": "blue", "index": 3}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 40},
                {"color": "green", "value": 70},
                {"color": "dark-green", "value": 90}
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "vertical",
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 7,
        "title": "24-Hour Temperature Trends",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
        "targets": [
          {
            "expr": "house_temperature",
            "legendFormat": "House Average",
            "refId": "A"
          },
          {
            "expr": "thermostat_current_temperature",
            "legendFormat": "Thermostat",
            "refId": "B"
          },
          {
            "expr": "hvac_target_temperature",
            "legendFormat": "Target Temp",
            "refId": "C"
          },
          {
            "expr": "outdoor_temperature",
            "legendFormat": "Outdoor",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {"group": "A", "mode": "none"},
              "axisPlacement": "auto",
              "axisLabel": "Temperature (°F)",
              "scaleDistribution": {"type": "linear"},
              "hideFrom": {"legend": false, "tooltip": false, "vis": false}
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            },
            "unit": "fahrenheit"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Target Temp"},
              "properties": [
                {"id": "custom.drawStyle", "value": "points"},
                {"id": "custom.pointSize", "value": 8},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
              ]
            }
          ]
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "list", "placement": "bottom"},
          "displayMode": "line"
        }
      }
    ]
  },
